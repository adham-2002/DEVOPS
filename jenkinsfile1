pipeline {
    agent any

    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_NAMESPACE = 'adhamelganzoury'
        KUBECONFIG = credentials('kubeconfig') // Ensure this credential exists in Jenkins
        K8S_NAMESPACE = 'kubeshop'
        HELM_VERSION = '3.12.0'
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'staging', 'prod'], description: 'Select deployment environment')
    }

    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/adham-2002/DEVOPS.git',
                    credentialsId: 'githubToken'
            }
        }

        stage('Build & Push Docker Images') {
            steps {
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh "echo \$DOCKER_PASS | docker login -u \$DOCKER_USER --password-stdin ${DOCKER_REGISTRY}"
                    }

                    // Build & Push Backend
                    def backendImage = docker.build("${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/ecommerce-backend:${env.BUILD_ID}-${params.ENVIRONMENT}")
                    backendImage.push()

                    // Build & Push Frontend
                    def frontendImage = docker.build("${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/ecommerce-frontend:${env.BUILD_ID}-${params.ENVIRONMENT}")
                    frontendImage.push()
                }
            }
        }

        stage('Setup Kubernetes Tools') {
            steps {
                sh """
                    curl -L https://get.helm.sh/helm-v${HELM_VERSION}-linux-amd64.tar.gz -o helm.tar.gz
                    tar -zxvf helm.tar.gz
                    mkdir -p ~/bin
                    mv linux-amd64/helm ~/bin/helm
                    export PATH=\$PATH:~/bin
                    ~/bin/helm version
                    kubectl version --client
                """
            }
        }

        stage('Deploy to kubeshop Namespace') {
            steps {
                script {
                    dir('k8s/helm-chart') {
                        sh "export PATH=\$PATH:~/bin && helm package . --version ${env.BUILD_ID}"

                        sh """
                            export PATH=\$PATH:~/bin
                            helm upgrade --install ecommerce-platform \
                                --namespace ${K8S_NAMESPACE} \
                                --set backend.image=${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/ecommerce-backend:${env.BUILD_ID}-${params.ENVIRONMENT} \
                                --set frontend.image=${DOCKER_REGISTRY}/${DOCKER_NAMESPACE}/ecommerce-frontend:${env.BUILD_ID}-${params.ENVIRONMENT} \
                                --values values-${params.ENVIRONMENT}.yaml \
                                ecommerce-platform-${env.BUILD_ID}.tgz
                        """
                    }
                }
            }
        }

        stage('Verify Deployment') {
            steps {
                sh """
                    kubectl get pods -n ${K8S_NAMESPACE}
                    kubectl get svc -n ${K8S_NAMESPACE}
                """
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        failure {
            script {
                emailext (
                    subject: "Pipeline Failed: ${env.JOB_NAME} - Build #${env.BUILD_NUMBER}",
                    body: "Pipeline failed. Check the build here: ${env.BUILD_URL}",
                    to: "your-team@example.com" // ← replace this with actual team email
                )
            }
        }
    }
}
